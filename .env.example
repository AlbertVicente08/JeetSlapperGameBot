# Copy this file to .env and fill in the values.
# .env is NEVER committed (it is in .gitignore). Never paste these keys in any chat.

# --- 1. Telegram (@BotFather -> /newbot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- 2. Cloudflare (no hace falta clave: se usa "npx wrangler login") ---
CLOUDFLARE_ACCOUNT_ID=

# --- 3. Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Secret: server only, never in the frontend
SUPABASE_SERVICE_ROLE_KEY=

# --- 4. Groq (console.groq.com -> API Keys) ---
GROQ_API_KEY=

# --- 5. Helius (dashboard.helius.dev -> API Keys) ---
HELIUS_API_KEY=

# --- 6. Admin: your Telegram user id (anti-cheat alerts, weekly winners) ---
ADMIN_TELEGRAM_ID=

# --- 7. Weekly tournament cron (Supabase pg_cron -> /api/cron/weekly) ---
CRON_SECRET=

# --- 8. Token mint address (empty until launch) ---
TOKEN_MINT=
