# Copia este archivo como .env y rellena los valores.
# .env NUNCA se sube a git (está en .gitignore). No pegues estas claves en ningún chat.

# --- 1. Telegram (@BotFather -> /newbot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- 2. Cloudflare (no hace falta clave: se usa "npx wrangler login") ---
CLOUDFLARE_ACCOUNT_ID=

# --- 3. Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Secreta: solo para el servidor, nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=

# --- 4. Groq (console.groq.com -> API Keys) ---
GROQ_API_KEY=

# --- 5. Helius (dashboard.helius.dev -> API Keys) ---
HELIUS_API_KEY=
